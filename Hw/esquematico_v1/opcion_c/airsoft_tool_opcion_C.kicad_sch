(label "UART_RX0" (at 337.82 80.01 180) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify right)) (uuid 213f515d-0efa-48c9-87d5-dcc50363464d))
(label "+3V3" (at 337.82 87.63 180) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify right)) (uuid 239e4cff-2fce-4a95-a5be-5d535fb60845))
(text "CC1/CC2 con 5.1k (R25, R26): el cargador entrega 5 V. VBUS_USB carga la bateria y alimenta el equipo." (at 208.28 100.33 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 9475dd36-28be-4593-a562-804f89fafa1c))
(text "U7 protege D+/D- contra ESD, junto a J1. R27/R28 22 ohm junto al modulo (guia de Espressif)." (at 208.28 102.87 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 5dea479f-ad48-4f55-95dd-8c90bdaee952))
(text "Grabar y depurar por USB: USB-Serial-JTAG del ESP32-S3 (esptool y OpenOCD, sin adaptador ni JTAG externo)." (at 208.28 105.41 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 2c4e15d9-f3bb-4980-b6f4-40b3134ce13b))
(text "J2: 1 GND, 2 TX0 (GPIO43 por R29 499 ohm), 3 RX0 (GPIO44, R37), 4 EN, 5 IO0, 6 3V3 de referencia." (at 208.28 109.22 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid bf1d9d92-2b78-4577-9151-bd1f0e8b8fc5))
(text "D5 queda en TX0: parpadea con el log de la ROM; la consola del firmware va por USB." (at 208.28 111.76 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 9791f64f-d31a-4aca-88c3-98af7f6b5b4e))
(text "No alimentar la placa por el pin 6 de J2 con la bateria conectada." (at 208.28 115.57 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid dfd17d13-1a5c-4d62-8e5b-fe8adc311496))
(rectangle (start 395 25) (end 584 100) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 90209b56-cc16-4938-af33-5492b71d0e7d))
(text "PANTALLA TFT 3.5in, BUS DE 16 BITS, TOUCH SPI (igual que v0.8)" (at 397.51 29.21 0) (effects (font (size 2 2) bold) (justify left)) (uuid 4c3eae89-464a-4781-970d-8864184cc39b))
