(label "GND" (at 187.96 118.11 270) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify right)) (uuid 3c180b9a-8e0b-462e-9b90-506e0b4e0506))
(wire (pts (xy 187.96 105.41) (xy 187.96 100.33)) (stroke (width 0) (type default)) (uuid 1a8e87e1-26d0-49e4-b860-5091312822fe))
(label "LED_ESTADO_A" (at 187.96 100.33 90) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify left)) (uuid df4507b4-2ef7-41cc-9ee6-512ef7dd1c48))
(text "EN: R22 10k + C10 1uF (guia de diseno de Espressif). SW5 = RESET, SW6 = BOOT (GPIO0 a GND)." (at 12.7 149.86 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid b8bb0e62-611d-4736-b927-b23b82f4b948))
(text "GPIO0 (I2S_DIN): pull-up R23. GPIO45 (I2S_LRC): pull-down R24, flash a 3.3 V. GPIO46 (TOUCH_MOSI): R9 a GND." (at 12.7 152.4 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid a35c74c3-2fd7-4811-9eb5-2f3553e5ec18))
(text "GPIO3 (LED_TIRA): R6 a GND. GPIO35, 36 y 37 son de la PSRAM octal de la N16R8: sin conectar." (at 12.7 156.21 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid f86febf1-d264-42cf-ab48-df24a5a9edbc))
(text "GPIO19/20 al USB-C (bloque USB). GPIO43 (U0TXD) maneja D5 y sale al header J2; GPIO44 (U0RXD) es RX de J2." (at 12.7 158.75 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 45213ed2-87fb-4e38-8587-a14af51117ce))
(text "C11 22uF y C12 100nF junto al pin 2 (3V3). EPAD (41) a GND. Zona libre de cobre bajo la antena." (at 12.7 162.56 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 7b513eba-bb64-40f2-83ba-4f3952057f9c))
(text "Pantalla en bus 8080 de 16 bits (LCD_CAM). Teclado, switches, boton, PEN, BL, SD del amplificador y deteccion de USB en U6." (at 12.7 165.1 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 83ae0950-95eb-44a1-9f2d-185cd685496a))
(text "D5 activo en alto, ~3.6 mA. R10/R11 pull-ups del I2C." (at 12.7 167.64 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 682ddc41-dcd0-44fc-bedc-bb1e02e86a9d))
(rectangle (start 205 25) (end 390 120) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid d04a4f74-b763-40b2-b708-d8da91f69fe2))
(text "USB-C (USB NATIVO) Y HEADER DE DEPURACION" (at 208.28 29.21 0) (effects (font (size 2 2) bold) (justify left)) (uuid f0fe989d-e942-47b6-bc7e-79227ad8a49f))
