(label "I2S_LRC" (at 133.35 100.33 0) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify left)) (uuid 41959227-dd13-49b3-8788-480989c681c9))
(label "TOUCH_MOSI" (at 133.35 102.87 0) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify left)) (uuid 274a6288-7ab7-49c0-9860-574ea855826f))
(text "EN: R22 10k + C10 1uF (guia de diseno de Espressif). SW5 = RESET, SW6 = BOOT (GPIO0 a GND)." (at 12.7 149.86 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid fbc4727d-c250-4383-8622-82eca2a88063))
(text "GPIO0 (I2S_DIN): pull-up R23. GPIO45 (I2S_LRC): pull-down R24, flash a 3.3 V. GPIO46 (TOUCH_MOSI): R9 a GND." (at 12.7 152.4 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 17ef332d-3a50-4b49-93b8-15db7ba32419))
(text "GPIO3 (LED_TIRA): R6 a GND. GPIO35, 36 y 37 son de la PSRAM octal de la N16R8: sin conectar." (at 12.7 156.21 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 1ea87d05-8b17-476e-aa52-c54cd65ef575))
(text "GPIO19/20 al USB-C (bloque USB). GPIO43 (U0TXD) maneja D5 y sale al header J2; GPIO44 (U0RXD) es RX de J2." (at 12.7 158.75 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 8c725a74-5cc4-444e-b143-e450eb9df302))
(text "C11 22uF y C12 100nF junto al pin 2 (3V3). EPAD (41) a GND. Zona libre de cobre bajo la antena." (at 12.7 162.56 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 0da5b7b2-12f1-4f89-babf-d9cfe2d198f8))
(text "Pantalla en bus 8080 de 16 bits (LCD_CAM). Teclado, switches, boton, PEN, BL, SD del amplificador y deteccion de USB en U6." (at 12.7 165.1 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 630e0261-ac02-4700-9325-1cafeb76e28b))
(text "D5 activo en alto, ~3.6 mA. R10/R11 pull-ups del I2C." (at 12.7 167.64 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 130b7e16-07c8-4099-84d8-17dd720bc384))
(rectangle (start 205 25) (end 390 120) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 60e3f3b8-08a0-4e05-a4f3-65e3c9a1d96a))
(text "USB-C (USB NATIVO) Y HEADER DE DEPURACION" (at 208.28 29.21 0) (effects (font (size 2 2) bold) (justify left)) (uuid d3a14cf7-17d0-4da2-9689-51e4aaba891d))
