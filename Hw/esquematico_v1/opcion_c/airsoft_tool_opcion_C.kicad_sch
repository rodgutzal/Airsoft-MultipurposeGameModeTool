(wire (pts (xy 187.96 113.03) (xy 187.96 118.11)) (stroke (width 0) (type default)) (uuid f58b6cf5-4ad4-4579-b2a5-248369a638e4))
(label "GND" (at 187.96 118.11 270) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify right)) (uuid 2354aecd-e6a3-488e-b0d7-01d54a9fbeb9))
(wire (pts (xy 187.96 105.41) (xy 187.96 100.33)) (stroke (width 0) (type default)) (uuid bd41db2f-18d4-4278-9bad-ee97427dd9f1))
(label "LED_ESTADO_A" (at 187.96 100.33 90) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify left)) (uuid 5a777add-539e-4f24-a153-65718394e1c2))
(text "EN: R22 10k + C10 1uF (guia de diseno de Espressif). SW5 = RESET, SW6 = BOOT (GPIO0 a GND)." (at 12.7 149.86 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 5a5a1903-a6b1-4b3a-b06e-ef026e879705))
(text "GPIO0 (I2S_DIN): pull-up R23. GPIO45 (I2S_LRC): pull-down R24, flash a 3.3 V. GPIO46 (TOUCH_MOSI): R9 a GND." (at 12.7 152.4 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid b0440f9c-3fcc-47b9-b7b9-5e8d1e94d879))
(text "GPIO3 (LED_TIRA): R6 a GND. GPIO35, 36 y 37 son de la PSRAM octal de la N16R8: sin conectar." (at 12.7 156.21 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 26431003-c02c-4c8b-b271-6c93bd46abca))
(text "GPIO19/20 al USB-C (bloque USB). GPIO43 (U0TXD) maneja D5 y sale al header J2; GPIO44 (U0RXD) es RX de J2." (at 12.7 158.75 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 64384f64-7448-4136-a884-8803b1c48132))
(text "C11 22uF y C12 100nF junto al pin 2 (3V3). EPAD (41) a GND. Zona libre de cobre bajo la antena." (at 12.7 162.56 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid d0d206d5-f2dd-49c2-86d4-b5add113b81d))
(text "Pantalla en bus 8080 de 16 bits (LCD_CAM). Teclado, switches, boton, PEN, BL, SD del amplificador y deteccion de USB en U6." (at 12.7 165.1 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid b11100f0-1ae6-4890-87a9-2f84be679900))
(text "D5 activo en alto, ~3.6 mA. R10/R11 pull-ups del I2C." (at 12.7 167.64 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 5657a2d3-af8b-422e-b8a2-40500d4ae255))
(rectangle (start 205 25) (end 390 120) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 0441ed8f-73e4-4fdf-ae50-2ecd8583f88e))
(text "USB-C (USB NATIVO) Y HEADER DE DEPURACION" (at 208.28 29.21 0) (effects (font (size 2 2) bold) (justify left)) (uuid dfd34fff-9189-42ee-8845-f19f6d9b8a96))
