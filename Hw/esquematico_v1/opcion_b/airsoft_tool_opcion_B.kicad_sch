(wire (pts (xy 80.01 45.72) (xy 85.09 45.72)) (stroke (width 0) (type default)) (uuid 4e7003c6-5101-4957-81ac-6b67ac243db8))
(label "LED_ESTADO_A" (at 85.09 45.72 0) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify left)) (uuid 811c02e7-98e4-41d9-8ae9-a52fd93b936d))
(text "LED de estado en GPIO43 (U0TXD)," (at 54.61 54.61 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid a715bff4-1145-463d-b393-3bf72980e131))
(text "activo en alto, ~3.6 mA." (at 54.61 58.42 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid ae30ee70-f1ed-4d2f-9033-0294a3230de4))
(text "GPIO1 y GPIO2 son ADC1: leen el touch resistivo compartido con LCD_RS y LCD_WR." (at 82.55 111.76 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid aa4337b4-96d8-4ea8-a745-10466bbacd0d))
(text "GPIO35-37 los usa la PSRAM octal. GPIO19/20 son el USB nativo. GPIO43 (U0TXD) maneja D5; GPIO44 libre (lo maneja el puente USB-UART)." (at 82.55 115.57 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 56307ed2-1bdb-4946-b2d4-3007600d3609))
(text "GPIO0, GPIO45 y GPIO46 son pines de arranque: solo llevan entradas de alta impedancia (DIN, LRC y la entrada de U5 con 100k a GND)." (at 82.55 118.11 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid e111f7dd-0754-48b5-a666-4b440a1985b5))
(text "GPIO48 maneja el LED RGB de la tarjeta v1.1: el boton solo lo lee como entrada." (at 82.55 120.65 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 43c83696-f2c2-4c08-8e98-3fd5fd085964))
(text "Toda entrada digital lleva pull-up externo de 10k. GPIO45 no debe llevar pull-up: en alto el arranque fija la flash a 1.8 V." (at 82.55 124.46 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid ac166dcb-5786-4ed2-92bc-eb0009b1a0d3))
(rectangle (start 225 25) (end 405 95) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 92a1ae1f-2c58-4028-8876-e3a40ae03417))
(text "PANTALLA TFT 3.5in PARALELA 8 BITS CON TOUCH" (at 228.6 29.21 0) (effects (font (size 2 2) bold) (justify left)) (uuid 273d7475-e350-429b-9e5e-3aa6b8de7d07))
