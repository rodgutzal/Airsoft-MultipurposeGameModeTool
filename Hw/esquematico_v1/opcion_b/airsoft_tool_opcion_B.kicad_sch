(wire (pts (xy 80.01 45.72) (xy 85.09 45.72)) (stroke (width 0) (type default)) (uuid 9e906937-4220-4692-9924-b85549cd9aeb))
(label "LED_ESTADO_A" (at 85.09 45.72 0) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify left)) (uuid 99953d35-998c-4bee-b768-150a3cf16928))
(text "LED de estado en GPIO43 (U0TXD)," (at 54.61 54.61 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 26b90391-21fe-496b-8d28-a9d546b014a6))
(text "activo en alto, ~3.6 mA." (at 54.61 58.42 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid a94f821e-ead0-46b0-b591-a068dac6771d))
(text "Pantalla en bus 8080 de 16 bits (LCD_CAM). Touch XPT2046 por SPI. Teclado, switches, boton, PEN y BL en el expansor U6 por I2C." (at 82.55 111.76 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 2779298f-ffd3-4100-bb18-469711e13920))
(text "GPIO35-37 los usa la PSRAM octal. GPIO19/20 son el USB nativo. GPIO43 (U0TXD) maneja D5; GPIO44 libre (puente USB-UART)." (at 82.55 115.57 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 265f859c-0c25-4d4e-bfa9-ae04c6f1821c))
(text "GPIO0, GPIO45 y GPIO46 son pines de arranque: solo cargas de alta impedancia; GPIO46 (MOSI) lleva R9 a GND, sin pull-up." (at 82.55 118.11 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 937b1c56-e1a5-4ec2-aa9f-f6a908c22899))
(text "LED RGB de la tarjeta: GPIO38 en v1.1 (lleva TOUCH_CLK, en reposo bajo, el LED no enciende), GPIO48 en v1.0." (at 82.55 120.65 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 88e8d81e-fe38-4875-a9f1-11116dc44a7a))
(text "GPIO45 no debe llevar pull-up: en alto el arranque fija la flash a 1.8 V. Las dos tiras van encadenadas en GPIO3." (at 82.55 124.46 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid c3d02bcf-2d27-44a3-b4cf-a0c448a1bd50))
(rectangle (start 225 25) (end 405 95) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 36e2e3fc-0b5b-464e-80fd-9cb7e07eef2e))
(text "PANTALLA TFT 3.5in, BUS DE 16 BITS, TOUCH SPI" (at 228.6 29.21 0) (effects (font (size 2 2) bold) (justify left)) (uuid 8df8a975-41a0-47b1-a148-677b7c3a68f0))
