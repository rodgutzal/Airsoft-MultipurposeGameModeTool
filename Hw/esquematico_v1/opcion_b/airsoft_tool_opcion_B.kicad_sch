(text "Pin 1 = CS (fila de arriba, izquierda)." (at 340.36 35.56 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 5e9920d9-3f94-422b-880e-58f8941d89cb))
(text "Impares arriba, pares abajo." (at 340.36 39.37 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid b0818222-f336-4737-a9c9-76524f149c82))
(text "El modulo solo acepta bus de 16 bits." (at 340.36 44.45 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 73c87a23-76e8-45ab-8e86-9561d18fc448))
(text "CS a GND: unico dispositivo en el bus." (at 340.36 46.99 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 705f227b-4e48-450a-a801-32cd96baf68d))
