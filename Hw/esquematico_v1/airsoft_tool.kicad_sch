(text "5V (28) es BL_VDD, sin conectar: la" (at 340.36 63.5 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 3d55bbef-4d85-482c-b0b0-93567631d08f))
(text "retroiluminacion toma 3.3 V por R5." (at 340.36 67.31 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid fa762880-a5a9-4484-bf50-f84ae8623bcb))
(text "BL alto = encendida (U6 GPB4)." (at 340.36 69.85 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 448e95b3-8c36-45ba-8497-167abcc97fa8))
(text "SDCS (22) y F_CS (32) a 3V3: microSD y" (at 340.36 74.93 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid e7bef69d-2467-495b-82df-ecc063e03e3e))
(text "flash comparten el SPI y quedan fuera." (at 340.36 77.47 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 0ca6a32f-8d91-42bb-8a2b-b01bc0fd79f4))
