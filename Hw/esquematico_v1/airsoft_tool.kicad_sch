(wire (pts (xy 392.43 179.07) (xy 392.43 173.99)) (stroke (width 0) (type default)) (uuid 05acb305-ede9-4008-b391-c2c10c94e1ce))
(label "+5V" (at 392.43 173.99 90) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify left)) (uuid 22f48373-6ee4-4d02-b0ee-9c62d61ac982))
