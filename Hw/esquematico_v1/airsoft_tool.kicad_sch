(label "LED_ESTADO_A" (at 85.09 45.72 0) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify left)) (uuid d1484e1e-f70e-4259-96d3-6c2b6c2ff8c2))
(text "LED de estado en GPIO43 (U0TXD)," (at 54.61 54.61 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 4df695ee-3606-41c1-9102-d95bacdcbce8))
(text "activo en alto, ~3.6 mA." (at 54.61 58.42 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 5b7f8ea8-554c-4c1c-ad99-769287321b56))
(text "GPIO1 y GPIO2 son ADC1: leen el touch resistivo compartido con LCD_RS y LCD_WR." (at 82.55 111.76 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid d76100ff-128c-4d4d-9e35-a4e79876c850))
(text "GPIO35-37 los usa la PSRAM octal. GPIO19/20 son el USB nativo. GPIO43 (U0TXD) maneja D5; GPIO44 libre (lo maneja el puente USB-UART)." (at 82.55 115.57 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 7b1b2400-bd84-41b6-b9c3-b291224def82))
(text "GPIO0, GPIO45 y GPIO46 son pines de arranque: solo llevan entradas de alta impedancia (DIN, LRC y la entrada de U5 con 100k a GND)." (at 82.55 118.11 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 2e09fd9a-22b0-4afd-9ea2-fa4356901388))
(text "GPIO48 maneja el LED RGB de la tarjeta v1.1: el boton solo lo lee como entrada." (at 82.55 120.65 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 51bf25c6-630e-4644-beda-653ea1943c97))
(text "Toda entrada digital lleva pull-up externo de 10k. GPIO45 no debe llevar pull-up: en alto el arranque fija la flash a 1.8 V." (at 82.55 124.46 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 653da241-ab97-4bba-9da4-45b782db9c88))
(rectangle (start 225 25) (end 405 95) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid f49ee35a-d056-47d6-a7fd-4095e1f8540d))
