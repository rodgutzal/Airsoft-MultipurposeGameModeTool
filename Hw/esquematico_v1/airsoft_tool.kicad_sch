(text "Pin 1 = CS (fila de arriba, izquierda)." (at 340.36 35.56 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid e880ab21-436d-4125-a548-cce2447b108d))
(text "Impares arriba, pares abajo." (at 340.36 39.37 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 43f40e1c-8add-4e3d-85d7-656ff1747a7b))
(text "El modulo solo acepta bus de 16 bits." (at 340.36 44.45 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid d686d92e-c518-4b68-aa5d-be227ef23093))
(text "CS a GND: unico dispositivo en el bus." (at 340.36 46.99 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid a1834b91-ebf3-461f-a53f-95ccd4ecaa30))
(text "RD fijo en alto con R1 (solo escritura)." (at 340.36 49.53 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 18de7220-f05a-4474-b642-72795dd93fb8))
(text "RST al EN de la tarjeta (reset comun)." (at 340.36 53.34 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid b2beabd6-8080-40a4-bef0-3724711072ec))
(text "VDD (24, 25) a 3V3 del DevKit: sirve con" (at 340.36 58.42 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 89f954cf-3806-4b11-a886-a80a7f385906))
