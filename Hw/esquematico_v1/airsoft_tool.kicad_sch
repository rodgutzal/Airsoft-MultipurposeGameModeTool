(wire (pts (xy 72.39 45.72) (xy 67.31 45.72)) (stroke (width 0) (type default)) (uuid dd6bac2f-d183-4871-9228-12f607bfb0a3))
(label "GND" (at 67.31 45.72 180) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify right)) (uuid 2f63480b-bd57-428f-b2ca-7f72123b407f))
(wire (pts (xy 80.01 45.72) (xy 85.09 45.72)) (stroke (width 0) (type default)) (uuid 75dc56e2-c4e3-4b22-88b5-90436677e6e3))
(label "LED_ESTADO_A" (at 85.09 45.72 0) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify left)) (uuid 66558799-2dd1-4c3b-a8a2-bbe39595e881))
(text "LED de estado en GPIO43 (U0TXD)," (at 54.61 54.61 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 822bd3e2-d59c-455f-95ca-32d14032e043))
(text "activo en alto, ~3.6 mA." (at 54.61 58.42 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid fd658582-af06-4152-b4b7-0b448466db33))
(text "Pantalla en bus 8080 de 16 bits (LCD_CAM). Touch XPT2046 por SPI. Teclado, switches, boton, PEN y BL en el expansor U6 por I2C." (at 82.55 111.76 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid f2b84ea6-284a-4ab4-aac2-2832bc1017cb))
(text "GPIO35-37 los usa la PSRAM octal. GPIO19/20 son el USB nativo. GPIO43 (U0TXD) maneja D5; GPIO44 libre (puente USB-UART)." (at 82.55 115.57 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 38076c0a-1372-4370-9514-03e2b5068e3a))
(text "GPIO0, GPIO45 y GPIO46 son pines de arranque: solo cargas de alta impedancia; GPIO46 (MOSI) lleva R9 a GND, sin pull-up." (at 82.55 118.11 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 7f6f5fdc-24fd-4619-8de6-cfdee6d5eda6))
(text "LED RGB de la tarjeta: GPIO38 en v1.1 (lleva TOUCH_CLK, en reposo bajo, el LED no enciende), GPIO48 en v1.0." (at 82.55 120.65 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid f44cbf3c-36eb-45ca-9486-92e7aa0f8844))
(text "GPIO45 no debe llevar pull-up: en alto el arranque fija la flash a 1.8 V. Las dos tiras van encadenadas en GPIO3." (at 82.55 124.46 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid a5962a8d-47e4-4472-9544-d99fbb2fe700))
(rectangle (start 225 25) (end 405 95) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 1596ea8c-5253-456d-bd18-b705f28372b1))
(text "PANTALLA TFT 3.5in, BUS DE 16 BITS, TOUCH SPI" (at 228.6 29.21 0) (effects (font (size 2 2) bold) (justify left)) (uuid f15e0e9e-1bb8-4e4f-b885-c160a4e9b2d2))
