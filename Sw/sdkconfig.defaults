# Objetivo: ESP32-S3-DevKitC-1 N16R8 (16 MB flash quad, 8 MB PSRAM octal)
CONFIG_IDF_TARGET="esp32s3"

# Flash 16 MB
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# PSRAM octal 8 MB
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# CPU a 240 MHz desde el arranque (PLL sobre el cristal de 40 MHz)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Gestion de energia: necesaria para esp_pm_configure (TimerInitialization)
CONFIG_PM_ENABLE=y
