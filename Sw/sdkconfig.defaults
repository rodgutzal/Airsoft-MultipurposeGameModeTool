# Objetivo: ESP32-S3-DevKitC-1 N16R8 (16 MB flash quad, 8 MB PSRAM octal)
CONFIG_IDF_TARGET="esp32s3"

# Flash 16 MB
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# PSRAM octal 8 MB
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# CPU a 240 MHz desde el arranque (PLL sobre el cristal de 40 MHz)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Gestion de energia: necesaria para esp_pm_configure (ConfigCpuClock)
CONFIG_PM_ENABLE=y

# Tabla de particiones propia (Sw/partitions.csv): nvs, OTA doble y storage
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Consola por el USB-Serial-JTAG (puerto USB de la tarjeta): libera GPIO43/44
# del UART0. GPIO43 maneja el LED de heartbeat (C_PIN_LED_ESTADO), asi que
# tampoco se deben escribir logs de la ROM por ese pin.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_BOOT_ROM_LOG_ALWAYS_OFF=y

# La ISR del timer sigue viva mientras se escribe o borra la flash
CONFIG_GPTIMER_ISR_IRAM_SAFE=y
